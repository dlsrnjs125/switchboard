{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtimeSecret", "config", "controlPlane", "distribution", "networkPolicy"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "runtimeSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseUrl", "kafkaBootstrapServers", "oidcJwkSetUri", "otlpTracesEndpoint", "otlpMetricsEndpoint", "outboxTopic", "traceSamplingProbability"],
      "properties": {
        "databaseUrl": {"type": "string", "pattern": "^jdbc:postgresql://"},
        "kafkaBootstrapServers": {"type": "string", "minLength": 1},
        "oidcJwkSetUri": {"type": "string", "format": "uri"},
        "otlpTracesEndpoint": {"type": "string", "format": "uri"},
        "otlpMetricsEndpoint": {"type": "string", "format": "uri"},
        "outboxTopic": {"type": "string", "minLength": 1},
        "traceSamplingProbability": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"}
      }
    },
    "controlPlane": {"$ref": "#/$defs/workload"},
    "distribution": {
      "allOf": [
        {"$ref": "#/$defs/workload"},
        {
          "type": "object",
          "required": ["maximumSessions", "consumerGroup"],
          "properties": {
            "maximumSessions": {"type": "integer", "minimum": 1},
            "consumerGroup": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "dependencyPorts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "dependencyPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "port"],
            "properties": {
              "protocol": {"enum": ["TCP", "UDP", "SCTP"]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        }
      }
    },
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "topologySpreadConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "$defs": {
    "workload": {
      "type": "object",
      "required": ["replicaCount", "image", "service", "resources", "probes", "terminationGracePeriodSeconds", "preStopDelaySeconds", "podDisruptionBudget", "autoscaling"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "service": {"type": "object"},
        "resources": {"type": "object"},
        "probes": {"type": "object"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 10},
        "preStopDelaySeconds": {"type": "integer", "minimum": 0},
        "podDisruptionBudget": {"type": "object"},
        "autoscaling": {"type": "object"},
        "outboxRelayEnabled": {"type": "boolean"},
        "maximumSessions": {"type": "integer"},
        "consumerGroup": {"type": "string"}
      }
    }
  }
}
